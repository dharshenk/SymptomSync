# UUID of the doctor appointments are booked with
DOCTOR_ID=11111111-1111-1111-1111-111111111111
SYSTEM_PROMPT_PATH=
LLM_MODEL=
LITE_LLM_MODEL=
PATIENT_REPORT_OUTPUT_PATH=

# Grafana Cloud: copy your stack's OpenTelemetry connection settings here.
# Use the HTTPS base endpoint ending in /otlp; the exporter appends /v1/traces.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Python requires Basic%20 (URL-encoded space) before the generated credentials.
# Example: Authorization=Basic%20<base64-credentials>
OTEL_EXPORTER_OTLP_HEADERS=
# Optional full trace URL; overrides the base endpoint when set.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://<your-otlp-host>/otlp/v1/traces
# Set to true to disable tracing even when an endpoint is configured.
OTEL_SDK_DISABLED=false
POSTGRES_MIGRATION_HOST=
# Full connection string for migrating a remote (Neon) DB; overrides POSTGRES_* in alembic only
NEON_DB_URL=
